# Example environment configuration.
# Copy this file to .env and fill in real values for local dev.
# In production, set these in Vercel's environment variables dashboard.
#
# Anything prefixed PUBLIC_ is bundled into client-side code and visible to anyone.
# Anything NOT prefixed PUBLIC_ stays server-side only.

# ─── Identity (PUBLIC — usernames are already public on the internet) ──────────
PUBLIC_GITHUB_USERNAME=NaushadAP
PUBLIC_DEVTO_USERNAME=naushadap
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/naushad-punjani-a3b014129/
PUBLIC_CONTACT_EMAIL=napunjani@gmail.com

# ─── Site config (PUBLIC) ─────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://naushadpunjani.com

# ─── Reserved for future use (server-side only — never expose) ────────────────
# GITHUB_TOKEN=                  # Personal access token, if we ever switch to GraphQL for pinned repos
# CONTACT_FORM_API_KEY=          # When adding a contact form via Resend, Formspree, etc.
# ANALYTICS_KEY=                 # Plausible/PostHog/etc.
